@model GBC_Ticketing_Group145.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0">
                <div class="card-header" style="background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);">
                    <h2 class="text-white text-center mb-0">Reset Your Password</h2>
                    <p class="text-white text-center mb-0 mt-2 small">Create a new secure password for your account</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ResetPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <input asp-for="Token" type="hidden" />
                        <input asp-for="Email" type="hidden" />

                        <div class="mb-3">
                            <label class="form-label fw-500">Email Address</label>
                            <p class="form-control-plaintext bg-light p-2 rounded">@Model.Email</p>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-500">New Password</label>
                            <div class="input-group">
                                <input asp-for="Password" 
                                       class="form-control" 
                                       placeholder="Enter your new password"
                                       id="passwordInput"
                                       autofocus />
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <span id="toggleIcon">Show</span>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text">
                                Password must be at least 8 characters long.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-500">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" 
                                   class="form-control" 
                                   placeholder="Confirm your new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Password Strength Indicator -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted">Password Strength:</small>
                                <small id="strengthText" class="fw-bold">-</small>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div id="strengthBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Reset Password
                            </button>
                        </div>

                        <hr class="my-4">

                        <div class="text-center">
                            <p class="mb-0">
                                <a asp-action="Login" class="text-decoration-none">Back to Login</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Password Requirements -->
            <div class="alert alert-info mt-4" role="alert">
                <h6 class="alert-heading">Password Requirements:</h6>
                <ul class="mb-0 small">
                    <li>At least 8 characters long</li>
                    <li>Use a mix of uppercase and lowercase letters</li>
                    <li>Include numbers</li>
                    <li>Avoid using common words or personal information</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Toggle password visibility
        document.getElementById('togglePassword').addEventListener('click', function () {
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.textContent = 'Hide';
            } else {
                passwordInput.type = 'password';
                toggleIcon.textContent = 'Show';
            }
        });

        // Password strength indicator
        document.getElementById('passwordInput').addEventListener('input', function () {
            const password = this.value;
            const strengthBar = document.getElementById('strengthBar');
            const strengthText = document.getElementById('strengthText');
            
            let strength = 0;
            let text = 'Weak';
            let color = 'bg-danger';
            
            if (password.length >= 6) strength += 25;
            if (password.length >= 10) strength += 25;
            if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength += 25;
            if (/[0-9]/.test(password) && /[^A-Za-z0-9]/.test(password)) strength += 25;
            
            if (strength === 0) {
                text = '-';
                color = 'bg-secondary';
            } else if (strength <= 25) {
                text = 'Weak';
                color = 'bg-danger';
            } else if (strength <= 50) {
                text = 'Fair';
                color = 'bg-warning';
            } else if (strength <= 75) {
                text = 'Good';
                color = 'bg-info';
            } else {
                text = 'Strong';
                color = 'bg-success';
            }
            
            strengthBar.style.width = strength + '%';
            strengthBar.className = 'progress-bar ' + color;
            strengthText.textContent = text;
            strengthText.className = 'fw-bold text-' + color.replace('bg-', '');
        });
    </script>
}
