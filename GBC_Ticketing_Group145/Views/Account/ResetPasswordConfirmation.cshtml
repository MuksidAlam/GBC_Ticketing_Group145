@{
    ViewData["Title"] = "Password Reset Successful";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0">
                <div class="card-header" style="background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);">
                    <h2 class="text-white text-center mb-0">Password Reset Successful!</h2>
                </div>
                <div class="card-body p-4 text-center">
                    <h4 class="mb-4">Your password has been changed</h4>
                    
                    <p class="lead mb-4">
                        Your password has been successfully reset. You can now log in with your new password.
                    </p>

                    <div class="alert alert-success text-start" role="alert">
                        <h6 class="alert-heading">What's Next?</h6>
                        <ul class="mb-0 ps-3">
                            <li>Use your new password to log in</li>
                            <li>Keep your password secure and don't share it</li>
                            <li>Consider enabling two-factor authentication for extra security</li>
                        </ul>
                    </div>

                    <hr class="my-4">

                    <div class="d-grid gap-2">
                        <a asp-action="Login" class="btn btn-primary btn-lg">
                            Log In Now
                        </a>
                    </div>

                    <div class="mt-4">
                        <p class="text-muted small">
                            Your account security is important to us. If you didn't request this change, 
                            please contact support immediately.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Security Tip -->
            <div class="alert alert-info mt-4" role="alert">
                <h6 class="alert-heading">Security Tip:</h6>
                <p class="mb-0 small">
                    To keep your account secure, we recommend changing your password regularly and 
                    using a unique password that you don't use on other websites.
                </p>
            </div>
        </div>
    </div>
</div>
