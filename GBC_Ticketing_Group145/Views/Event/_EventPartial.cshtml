@model IEnumerable<GBC_Ticketing_Group145.Models.Event>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Date & Time</th>
                <th>Price</th>
                <th>Available Tickets</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.Title</strong>
                        @if (item.AvailableTickets < 10)
                        {
                            <br />
                            <small class="text-danger">
                                Low stock!
                            </small>
                        }
                    </td>
                    <td>
                        <span class="badge bg-secondary">@item.Category?.Name</span>
                    </td>
                    <td>@item.DateTime.ToString("MMM dd, yyyy")<br /><small class="text-muted">@item.DateTime.ToString("h:mm tt")</small></td>
                    <td><strong>$@item.TicketPrice.ToString("0.00")</strong></td>
                    <td>
                        @{
                            var badgeClass = item.AvailableTickets < 5 ? "bg-danger" : 
                                           item.AvailableTickets < 10 ? "bg-warning" : "bg-success";
                        }
                        <span class="badge @badgeClass">
                            @item.AvailableTickets available
                        </span>
                    </td>
                    <td>
                        @if (item.AvailableTickets > 0)
                        {
                            <button class="btn btn-sm btn-primary add-to-cart-btn" 
                                    data-event-id="@item.Id" 
                                    data-event-title="@item.Title"
                                    data-event-price="@item.TicketPrice"
                                    data-available-tickets="@item.AvailableTickets">
                                Add to Cart
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled>
                                Sold Out
                            </button>
                        }
                        
                        @if (User.IsInRole("Organizer") || User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info" role="alert">
        No events found matching your criteria. Try adjusting your filters.
    </div>
}
