@model GBC_Ticketing_Group145.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Event</h1>

<h3>Are you sure you want to delete this event?</h3>
<p class="text-danger">This action cannot be undone.</p>
<div>
    <h4>Event Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Category)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Category!.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DateTime)
        </dt>
        <dd class="col-sm-9">
            @Model.DateTime.ToString("MM/dd/yyyy h:mm tt")
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.TicketPrice)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.TicketPrice)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.AvailableTickets)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.AvailableTickets)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirm Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Cancel and Back to List</a>
    </form>
</div>